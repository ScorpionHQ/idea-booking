# انسخ هذا الملف إلى .env وعِّد القيم قبل النشر
DJANGO_SECRET_KEY=ضع-مفتاحا-سريطا-طويلا-عشوائيا-هنا
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=YOURUSERNAME.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOURUSERNAME.pythonanywhere.com

# sqlite افتراضي للتطوير | postgres للإنتاج
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

SESSION_COOKIE_AGE=28800
